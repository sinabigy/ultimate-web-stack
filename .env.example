# Copy to .env for local overrides (./dev setup does this). Never commit .env.
# All application settings use APP__SECTION__KEY (see backend/crates/config/src/lib.rs).

# --- core (PostgreSQL is part of every profile) ---
APP__DATABASE__URL=postgres://app:app-dev-only@localhost:55432/app
APP__LOG__FORMAT=pretty

# --- identity (./dev up --identity mock|zitadel sets these automatically) ---
# APP__AUTH__PROVIDER=zitadel
# APP__AUTH__ISSUER_URL=http://localhost:58081
# APP__AUTH__CLIENT_ID=
# APP__AUTH__CLIENT_SECRET=
# Production requires both (32-byte base64 key; long random pepper):
# APP__AUTH__TOKEN_ENCRYPTION_KEY=
# APP__AUTH__API_KEY_PEPPER=
# APP__AUTH__BOOTSTRAP_SYSTEM_ADMINS=[you@example.com]

# --- optional modules (enable in .ai/config/project.json → architecture.modules too) ---
# APP__CACHE__BACKEND=redis
# APP__CACHE__REDIS_URL=redis://localhost:56379
# APP__MESSAGING__ENABLED=true
# APP__MESSAGING__NATS_URL=nats://localhost:54222
# APP__ANALYTICS__ENABLED=true
# APP__ANALYTICS__CLICKHOUSE_URL=http://localhost:58123

# --- dev ports (compose) ---
# DEV_PG_PORT=55432
# DEV_ZITADEL_PORT=58081

# Observability profile (./dev up --with observability)
# DEV_PROMETHEUS_PORT=59190
# DEV_GRAFANA_PORT=53000
# DEV_LOKI_PORT=53100
# DEV_TEMPO_PORT=53200
# DEV_TEMPO_OTLP_PORT=54318
# APP__TELEMETRY__OTLP_ENDPOINT=http://127.0.0.1:54318
# APP__TELEMETRY__TRACE_PROPAGATION=true
