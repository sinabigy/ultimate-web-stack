#!/usr/bin/env python3
"""Developer CLI. One entry point for the whole stack; standard library only.

  ./dev setup                 one-time: git hooks, toolchain/npm deps, Playwright browser
  ./dev doctor                show which tools/services are available (what will be skipped)
  ./dev up [--identity mock|zitadel] [--no-app]
                              start services for the enabled modules (from .ai/config/project.json
                              → architecture.modules), migrate, and run backend + frontend dev servers
  ./dev down [--volumes]      stop everything (and delete data volumes)
  ./dev status                containers and app health
  ./dev check [--auth] [--strict]
                              canonical validation (tools/ai-validate) + optional identity checks
  ./dev test [--e2e] [--zitadel]
                              backend + frontend tests; optional browser suites
  ./dev benchmark [--smoke]   benchmark suites + regression gates + report (benchmarks/)
  ./dev types                 regenerate TypeScript bindings from Rust API types
  ./dev db migrate|reset|prepare|psql
  ./dev logs [service]

Validation commands are NOT duplicated here: `check` delegates to tools/ai-validate, which runs
the confirmed commands in .ai/config/project.json.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import threading
import sys
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
COMPOSE = ["docker-compose"] if shutil.which("docker-compose") else ["docker", "compose"]
COMPOSE_FILE = ROOT / "infra/docker/compose.yaml"
ENV = dict(os.environ)
ENV["PATH"] = f"{Path.home()}/.cargo/bin:{ENV.get('PATH', '')}"
ENV.setdefault("DATABASE_URL", "postgres://app:app-dev-only@localhost:55432/app")
PIDS = ROOT / "var/dev-pids.json"

# module name → compose profile/services it needs
# architecture module → (compose profile, services, start automatically). Heavy optional stacks
# start only with `./dev up --with <module>`.
MODULE_SERVICES = {
    "cache": ("cache", ["redis"], True),
    "messaging_nats": ("messaging", ["nats"], True),
    "analytics_clickhouse": ("analytics", ["clickhouse"], True),
    "observability": ("observability", ["prometheus", "tempo", "loki", "alloy", "grafana"], False),
}
LOG_DIR = ROOT / "var" / "log"


def spawn_logged(name: str, cmd: list[str], cwd: Path, env: dict) -> subprocess.Popen:
    """Start a process whose output goes to the console and to var/log/<name>.log (shipped to
    Loki by the observability profile)."""
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

    def pump() -> None:
        with open(LOG_DIR / f"{name}.log", "a", encoding="utf-8") as f:
            for line in proc.stdout:  # type: ignore[union-attr]
                sys.stdout.write(line)
                f.write(line)
                f.flush()

    threading.Thread(target=pump, daemon=True).start()
    return proc


def sh(cmd: list[str] | str, cwd: Path = ROOT, check: bool = True, env: dict | None = None, quiet: bool = False) -> int:
    if not quiet:
        print(f"$ {cmd if isinstance(cmd, str) else ' '.join(cmd)}", flush=True)
    r = subprocess.run(cmd, cwd=cwd, env=env or ENV, shell=isinstance(cmd, str))
    if check and r.returncode != 0:
        sys.exit(r.returncode)
    return r.returncode


def compose(*args: str, profiles: list[str] | None = None, check: bool = True) -> int:
    cmd = COMPOSE + ["-f", str(COMPOSE_FILE)]
    for p in profiles or []:
        cmd += ["--profile", p]
    return sh(cmd + list(args), check=check)


def project() -> dict:
    return json.loads((ROOT / ".ai/config/project.json").read_text())


def enabled_modules() -> list[str]:
    mods = (project().get("architecture") or {}).get("modules") or {}
    return [m for m, v in mods.items() if isinstance(v, dict) and v.get("enabled")]


def wait_http(url: str, seconds: int = 60) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as r:
                if r.status < 500:
                    return True
        except Exception:
            time.sleep(1)
    return False


def wait_healthy(container: str, seconds: int = 120) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        r = subprocess.run(["docker", "inspect", "-f", "{{.State.Health.Status}}", container], capture_output=True, text=True)
        if r.stdout.strip() == "healthy":
            return True
        time.sleep(1)
    return False


def load_env_file(path: Path) -> dict[str, str]:
    out = {}
    if path.is_file():
        for line in path.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    return out


# ------------------------------------------------------------------ commands

def cmd_setup(_a) -> None:
    sh(["git", "config", "core.hooksPath", ".githooks"])
    if not shutil.which("cargo", path=ENV["PATH"]):
        print("Rust not found: install with https://rustup.rs (the toolchain is pinned in backend/rust-toolchain.toml)")
    else:
        sh(["cargo", "fetch", "-q"], cwd=ROOT / "backend")
    if shutil.which("npm"):
        sh(["npm", "ci", "--no-audit", "--no-fund"], cwd=ROOT / "frontend")
        sh(["npx", "playwright", "install", "chromium"], cwd=ROOT / "frontend", check=False)
    if not (ROOT / ".env").exists() and (ROOT / ".env.example").exists():
        shutil.copy(ROOT / ".env.example", ROOT / ".env")
        print("created .env from .env.example (development defaults)")
    print("setup complete. Next: ./dev up")


def cmd_doctor(_a) -> None:
    tools = ["cargo", "cargo-sqlx", "node", "npm", "docker", "python3", "oha", "git"]
    for t in tools:
        path = shutil.which(t, path=ENV["PATH"])
        print(f"  {'✓' if path else '✗'} {t:<12} {path or 'missing'}")
    r = subprocess.run(["docker", "info"], capture_output=True)
    print(f"  {'✓' if r.returncode == 0 else '✗'} docker daemon")
    print(f"  enabled modules: {', '.join(enabled_modules()) or 'core only'}")


def cmd_up(a) -> None:
    profiles, services = [], ["postgres"]
    mods = (project().get("architecture") or {}).get("modules") or {}
    wanted = [m for m in enabled_modules() if MODULE_SERVICES.get(m, ("", [], False))[2]] + list(a.with_modules)
    for m in dict.fromkeys(wanted):
        if m not in MODULE_SERVICES:
            sys.exit(f"unknown module for --with: {m} (known: {', '.join(MODULE_SERVICES)})")
        if m == "cache" and mods.get("cache", {}).get("adapter", "memory") == "memory" and m not in a.with_modules:
            continue  # in-process cache: no Redis needed
        p, svcs, _auto = MODULE_SERVICES[m]
        profiles.append(p)
        services += svcs
    observability = "prometheus" in services
    if a.identity == "zitadel":
        profiles.append("identity")
        services.append("zitadel")
    compose("up", "-d", *services, profiles=profiles)
    if not wait_healthy(f"{os.environ.get('COMPOSE_PROJECT_NAME', 'uwsb')}-postgres-1"):
        sys.exit("postgres did not become healthy")
    sh(["cargo", "sqlx", "migrate", "run", "--source", "migrations"], cwd=ROOT / "backend")
    if a.identity == "zitadel":
        sh([sys.executable, "scripts/zitadel_bootstrap.py"])
    if a.no_app:
        return
    app_env = dict(ENV)
    app_env.update({"APP__DATABASE__URL": ENV["DATABASE_URL"], "APP__HTTP__BENCH_ENDPOINTS": "true"})
    if observability:
        # Traces to Tempo; JSON logs (with trace_id) tailed into Loki by Alloy.
        app_env.update({"APP__TELEMETRY__OTLP_ENDPOINT": "http://127.0.0.1:" + os.environ.get("DEV_TEMPO_OTLP_PORT", "54318"),
                        "APP__LOG__FORMAT": "json"})
    procs = {}
    sh(["cargo", "build", "-q", "-p", "fake-upstream", "-p", "mock-oidc", "-p", "app-server"], cwd=ROOT / "backend")
    # Simulated external provider used by the example app's runs (no internet needed).
    procs["fake-upstream"] = subprocess.Popen([str(ROOT / "backend/target/debug/fake-upstream")], cwd=ROOT, env=app_env)
    if a.identity == "mock":
        procs["mock-oidc"] = subprocess.Popen([str(ROOT / "backend/target/debug/mock-oidc")], cwd=ROOT, env=app_env)
        app_env.update({"APP__AUTH__PROVIDER": "oidc", "APP__AUTH__ISSUER_URL": "http://127.0.0.1:59081", "APP__AUTH__CLIENT_ID": "app-web"})
    else:
        app_env.update(load_env_file(ROOT / ".env.zitadel"))
    app_env.update(load_env_file(ROOT / ".env"))
    procs["app-server"] = spawn_logged("app-server", [str(ROOT / "backend/target/debug/app-server")], ROOT / "backend", app_env)
    procs["vite"] = subprocess.Popen(["npm", "run", "-s", "dev"], cwd=ROOT / "frontend", env=app_env)
    PIDS.parent.mkdir(exist_ok=True)
    PIDS.write_text(json.dumps({k: p.pid for k, p in procs.items()}))
    ok = wait_http("http://localhost:8080/readyz", 60) and wait_http("http://localhost:5190/", 60)
    print(f"\n{'ready' if ok else 'started (not all endpoints answered yet)'}:  app http://localhost:5190   api http://localhost:8080"
          f"   identity: {a.identity}{' (any email on the mock login page)' if a.identity == 'mock' else ' (alice@example.com / see .env.zitadel)'}")
    if observability:
        print("observability: grafana http://localhost:" + os.environ.get("DEV_GRAFANA_PORT", "53000")
              + "  prometheus http://localhost:" + os.environ.get("DEV_PROMETHEUS_PORT", "59190"))
    print("Ctrl-C stops the app processes (services keep running; ./dev down stops them).")

    def _interrupt(*_args) -> None:
        raise KeyboardInterrupt

    # Explicit handlers: a parent may have started us with SIGINT ignored (background jobs of
    # non-interactive shells), and SIGTERM (e.g. from a supervisor) should stop children too.
    signal.signal(signal.SIGINT, _interrupt)
    signal.signal(signal.SIGTERM, _interrupt)
    try:
        while all(p.poll() is None for p in procs.values()):
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        for p in procs.values():
            if p.poll() is None:
                p.send_signal(signal.SIGTERM)
        for p in procs.values():
            try:
                p.wait(timeout=20)
            except subprocess.TimeoutExpired:
                p.kill()
        PIDS.unlink(missing_ok=True)


def cmd_down(a) -> None:
    if PIDS.exists():
        for pid in json.loads(PIDS.read_text()).values():
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        PIDS.unlink(missing_ok=True)
    args = ["down", "--remove-orphans"] + (["--volumes"] if a.volumes else [])
    compose(*args, profiles=["cache", "messaging", "analytics", "identity", "observability", "dragonfly"])


def cmd_status(_a) -> None:
    compose("ps", profiles=["cache", "messaging", "analytics", "identity", "observability", "dragonfly"], check=False)
    for url in ["http://localhost:8080/readyz", "http://localhost:5190/"]:
        try:
            with urllib.request.urlopen(url, timeout=2) as r:
                print(f"  {url}: {r.status}")
        except Exception as e:
            print(f"  {url}: down ({e.__class__.__name__})")


def ensure_postgres() -> None:
    compose("up", "-d", "postgres", check=True)
    if not wait_healthy(f"{os.environ.get('COMPOSE_PROJECT_NAME', 'uwsb')}-postgres-1"):
        sys.exit("postgres did not become healthy")


def cmd_check(a) -> None:
    ensure_postgres()
    args = [sys.executable, "tools/ai-validate", "--keep-going"] + (["--strict"] if a.strict else [])
    code = sh(args, check=False)
    if a.auth:
        env = dict(ENV)
        env.update(load_env_file(ROOT / ".env.zitadel"))
        code |= sh(["cargo", "run", "-q", "-p", "app-server", "--", "check-config", "--online"], cwd=ROOT / "backend", env=env, check=False)
    sys.exit(code)


def cmd_test(a) -> None:
    ensure_postgres()
    code = sh(["cargo", "test", "--workspace"], cwd=ROOT / "backend", check=False)
    code |= sh(["npm", "test"], cwd=ROOT / "frontend", check=False)
    if a.e2e:
        code |= sh("node scripts/e2e-prepare.mjs && npx playwright test", cwd=ROOT / "frontend", check=False)
    if a.zitadel:
        compose("up", "-d", "zitadel", profiles=["identity"])
        sh([sys.executable, "scripts/zitadel_bootstrap.py"])
        code |= sh("node scripts/e2e-prepare.mjs && npx playwright test -c playwright.zitadel.config.ts", cwd=ROOT / "frontend", check=False)
    sys.exit(code)


def cmd_benchmark(a) -> None:
    """Run suites, then apply the gates and render docs/benchmarks/latest.md (full runs only)."""
    smoke = ["--smoke"] if a.smoke else []
    rc = sh([sys.executable, "benchmarks/run.py"] + smoke + a.extra, check=False)
    gate = sh([sys.executable, "benchmarks/compare.py"] + smoke, check=False)
    if not a.smoke:
        sh([sys.executable, "benchmarks/report.py"], check=False)
    sys.exit(rc or gate)


def cmd_types(_a) -> None:
    sh(["cargo", "test", "-q", "--workspace", "export_bindings"], cwd=ROOT / "backend")
    print("TypeScript bindings written to frontend/src/api/generated")


def cmd_db(a) -> None:
    ensure_postgres()
    b = ROOT / "backend"
    if a.action == "migrate":
        sh(["cargo", "sqlx", "migrate", "run", "--source", "migrations"], cwd=b)
    elif a.action == "reset":
        sh(["cargo", "sqlx", "database", "reset", "-y", "--source", "migrations"], cwd=b)
    elif a.action == "prepare":
        sh(["cargo", "sqlx", "prepare", "--workspace"], cwd=b)
    elif a.action == "psql":
        sh(["docker", "exec", "-it", f"{os.environ.get('COMPOSE_PROJECT_NAME', 'uwsb')}-postgres-1", "psql", "-U", "app", "-d", "app"])


def cmd_logs(a) -> None:
    compose("logs", "-f", *([a.service] if a.service else []), profiles=["cache", "messaging", "analytics", "identity", "observability"], check=False)


def main() -> None:
    ap = argparse.ArgumentParser(prog="./dev", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("setup").set_defaults(fn=cmd_setup)
    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)
    up = sub.add_parser("up")
    up.add_argument("--identity", choices=["mock", "zitadel"], default="mock")
    up.add_argument("--no-app", action="store_true", help="only start services and migrate")
    up.add_argument("--with", dest="with_modules", action="append", default=[], metavar="MODULE",
                    help="also start an optional module's services, e.g. --with observability")
    up.set_defaults(fn=cmd_up)
    dn = sub.add_parser("down")
    dn.add_argument("--volumes", action="store_true")
    dn.set_defaults(fn=cmd_down)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    ck = sub.add_parser("check")
    ck.add_argument("--auth", action="store_true", help="also validate the identity provider online (.env.zitadel)")
    ck.add_argument("--strict", action="store_true", help="skipped checks fail")
    ck.set_defaults(fn=cmd_check)
    te = sub.add_parser("test")
    te.add_argument("--e2e", action="store_true")
    te.add_argument("--zitadel", action="store_true")
    te.set_defaults(fn=cmd_test)
    be = sub.add_parser("benchmark")
    be.add_argument("--smoke", action="store_true")
    be.add_argument("extra", nargs=argparse.REMAINDER)
    be.set_defaults(fn=cmd_benchmark)
    sub.add_parser("types").set_defaults(fn=cmd_types)
    db = sub.add_parser("db")
    db.add_argument("action", choices=["migrate", "reset", "prepare", "psql"])
    db.set_defaults(fn=cmd_db)
    lg = sub.add_parser("logs")
    lg.add_argument("service", nargs="?")
    lg.set_defaults(fn=cmd_logs)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
