  "query": "SELECT id, created_at, last_seen_at, expires_at, ip, user_agent, mfa, amr FROM sessions\n           WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > now() AND idle_expires_at > now()\n           ORDER BY last_seen_at DESC LIMIT 100",
