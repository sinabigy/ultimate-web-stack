{
  "db_name": "PostgreSQL",
  "query": "SELECT i.id, i.email, i.role_id, r.key AS role_key, i.invited_by, i.created_at, i.expires_at\n           FROM invitations i JOIN roles r ON r.id = i.role_id\n           WHERE i.organization_id = $1 AND i.accepted_at IS NULL AND i.revoked_at IS NULL AND i.expires_at > now()\n           ORDER BY i.created_at DESC",
