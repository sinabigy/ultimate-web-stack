  "components": {
    "schemas": {
      "AnalyticsPoint": {
        "type": "object",
        "description": "One day of an analytics series (from ClickHouse).",
        "required": [
          "day",
          "events",
          "value"
        ],
        "properties": {
          "day": {
            "type": "string",
            "description": "`YYYY-MM-DD` (UTC)."
          },
          "events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "AuditRow": {
        "type": "object",
        "required": [
          "id",
          "occurred_at",
          "actor_type",
          "action",
          "outcome",
          "metadata"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actor_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_type": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {},
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "organization_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "Field-level validation problem.",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ListResponse_MemberRow": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "user_id",
                "email",
                "display_name",
                "role_id",
                "role_key",
                "role_name",
                "joined_at"
              ],
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "joined_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "last_login_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "role_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "role_key": {
                  "type": "string"
                },
                "role_name": {
                  "type": "string"
                },
                "user_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "ListResponse_PermissionInfo": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "description",
                "owner_only",
                "credential_assignable"
              ],
              "properties": {
                "credential_assignable": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "owner_only": {
                  "type": "boolean"
                }
              }
            }
          }
