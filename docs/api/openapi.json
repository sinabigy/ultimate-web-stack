{
  "openapi": "3.1.0",
  "info": {
    "title": "Integration API",
    "description": "Operations for API keys and service accounts. Authenticate with `Authorization: Bearer <credential>`; errors are RFC 9457 problem details; every response carries `x-request-id`. Examples: examples/api-clients.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "v1"
  },
  "paths": {
    "/api/v1/orgs/{slug}/analytics/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Daily run activity from ClickHouse. 404 when the analytics module is off.",
        "operationId": "run_analytics",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Organization slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAnalytics"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked credential. Never falls back to another method.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The credential's scopes do not include the operation's permission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource, or an organization the credential does not belong to.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; wait for `Retry-After` seconds.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "runs:read"
            ]
          }
        ]
      }
    },
