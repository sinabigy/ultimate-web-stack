# Development ports of this project: the single source for ./dev, compose, Vite, Playwright, the
# validation commands and the smoke scripts. `./dev ports` shows them and what holds each one.
#
# A generated project gets its own block (scripts/create-project --port-base), so several projects
# run side by side. An environment variable of the same name overrides one port for one run.
# Every port binds to 127.0.0.1; none of these are production settings.

# Processes started by ./dev up
DEV_API_PORT=8080
DEV_WEB_PORT=5190
DEV_MOCK_OIDC_PORT=59081
DEV_UPSTREAM_PORT=59090
DEV_WORKER_PORT=9091

# Containers (infra/docker/compose.yaml)
DEV_PG_PORT=55432
DEV_REDIS_PORT=56379
DEV_DRAGONFLY_PORT=56380
DEV_NATS_PORT=54222
DEV_NATS_MONITOR_PORT=58222
DEV_CLICKHOUSE_PORT=58123
DEV_ZITADEL_PORT=58081
DEV_GRAFANA_PORT=53000
DEV_PROMETHEUS_PORT=59190
DEV_LOKI_PORT=53100
DEV_TEMPO_PORT=53200
DEV_TEMPO_OTLP_PORT=54318

# Validation (./dev check): browser E2E servers and the release-image smoke test
DEV_E2E_API_PORT=18080
DEV_E2E_IDP_PORT=59082
DEV_E2E_UPSTREAM_PORT=59091
DEV_SMOKE_PORT=18299
