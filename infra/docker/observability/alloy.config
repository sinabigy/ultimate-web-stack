// Ships the app's JSON logs (written by ./dev up to var/log/*.log) to Loki.
// trace_id / request_id / level become structured metadata or labels so Grafana can jump
// from a log line to its trace in Tempo.
local.file_match "app" {
  path_targets = [{ "__path__" = "/var/log/app/*.log" }]
}

loki.source.file "app" {
  targets    = local.file_match.app.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  stage.json {
    expressions = { level = "level", trace_id = "span.trace_id", request_id = "span.request_id", target = "target" }
  }
  stage.labels {
    values = { level = "", target = "" }
  }
  stage.structured_metadata {
    values = { trace_id = "", request_id = "" }
  }
  stage.static_labels {
    values = { service = "app" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
