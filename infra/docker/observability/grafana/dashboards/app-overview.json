{
 "uid": "app-overview",
 "title": "App overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "app"
 ],
 "panels": [
  {
   "type": "row",
   "title": "HTTP (RED)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests / s by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(app_http_requests_total[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error ratio (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(app_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(app_http_requests_total[1m])), 1e-9)",
     "legendFormat": "5xx ratio"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Latency p50 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(app_http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(app_http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "In flight / shed / rate limited",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app_http_inflight_requests",
     "legendFormat": "in flight"
    },
    {
     "refId": "B",
     "expr": "rate(app_http_shed_total[1m])",
     "legendFormat": "shed/s"
    },
    {
     "refId": "C",
     "expr": "rate(app_rate_limited_total[1m])",
     "legendFormat": "rate limited/s"
    }
   ]
  },
  {
   "type": "row",
   "title": "Outbound providers",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Provider requests / s by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, outcome) (rate(app_provider_requests_total[1m]))",
     "legendFormat": "{{provider}} {{outcome}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Concurrency limit and learned rate cap",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app_provider_concurrency_limit",
     "legendFormat": "{{provider}} concurrency"
    },
    {
     "refId": "B",
     "expr": "app_provider_learned_rps",
     "legendFormat": "{{provider}} learned req/s"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Provider latency p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(app_provider_latency_seconds_bucket[1m])))",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retries and circuit opens",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (rate(app_provider_retries_total[1m]))",
     "legendFormat": "{{provider}} retries/s"
    },
    {
     "refId": "B",
     "expr": "rate(app_provider_circuit_opened_total[5m])",
     "legendFormat": "circuit opens/s"
    }
   ]
  },
  {
   "type": "row",
   "title": "Jobs and cache",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Jobs processed / s by result",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind, result) (rate(app_jobs_processed_total[1m]))",
     "legendFormat": "{{kind}} {{result}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(app_cache_requests_total{result=\"hit\"}[1m])) / clamp_min(sum(rate(app_cache_requests_total[1m])), 1e-9)",
     "legendFormat": "hit ratio"
    }
   ]
  },
  {
   "type": "logs",
   "title": "Error logs (click trace_id \u2192 Tempo)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 43,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"app\", level=~\"ERROR|WARN\"}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}
