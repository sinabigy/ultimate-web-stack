# VPS tier: API + static frontend from one binary. Install: see docs/deployment/vps.md
[Unit]
Description=App API server
Documentation=file:///opt/app/docs/deployment/vps.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=app
Group=app
WorkingDirectory=/opt/app
EnvironmentFile=/etc/app/app.env
Environment=APP__HTTP__HOST=127.0.0.1 APP__HTTP__PORT=8080 APP__HTTP__OPS_PORT=9090 APP__HTTP__STATIC_DIR=/opt/app/web APP__LOG__FORMAT=json
ExecStartPre=/opt/app/bin/app-server check-config
ExecStart=/opt/app/bin/app-server
# Graceful drain: the server reports not-ready, drains, then exits within its shutdown timeout.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576

# Hardening (systemd-analyze security app-server.service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
