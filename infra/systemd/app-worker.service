# VPS tier (optional): background jobs in a separate process. With it enabled, set
# APP__JOBS__RUN_IN_PROCESS=false for app-server in /etc/app/app.env.
[Unit]
Description=App background worker
Documentation=file:///opt/app/docs/deployment/vps.md
After=network-online.target postgresql.service app-server.service
Wants=network-online.target

[Service]
Type=exec
User=app
Group=app
WorkingDirectory=/opt/app
EnvironmentFile=/etc/app/app.env
Environment=APP__HTTP__HOST=127.0.0.1 APP__WORKER__PORT=9091 APP__LOG__FORMAT=json
ExecStart=/opt/app/bin/app-worker
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
