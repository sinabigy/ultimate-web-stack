#!/usr/bin/env python3
"""create-project: generate a new application from this blueprint (non-interactive).

    scripts/create-project DEST --name "Acme" [options]
    scripts/create-project                      # interactive (prompts on a terminal)

Options:
  --profile core|performance|distributed|full  module bundle (default core); --modules adds to it
                                           core: none · performance: cache · distributed: cache,
                                           messaging_nats, analytics_clickhouse · full: + observability
  --auth basic|consumer|b2b|enterprise     auth feature bundle (default b2b)
  --organizations / --no-organizations     multi-organisation tenancy (default: on for b2b/enterprise)
  --admin / --no-admin                     system admin console (default on)
  --cedar                                  Cedar policy engine (built with feature `cedar`)
  --modules LIST                           comma list of optional modules (default: none = core profile)
                                           cache, messaging_nats, analytics_clickhouse, observability
  --with-gateway                           keep the Pingora gateway workspace (hyperscale edge)
  --objective TEXT                         recorded in .ai/config/project.json (only if you have one)
  --no-git                                 do not create a git repository / initial commit
  --start / --no-start                     run ./dev up afterwards (default: no)
  --force                                  allow a non-empty DEST

What it does:
  1. copies the blueprint's tracked files (git ls-files), minus optional parts not selected;
  2. writes backend/config/app.toml (auth profile, tenancy, admin, authorization, modules);
  3. updates .ai/config/project.json → architecture (modules enabled/disabled, components, profile);
  4. renames the product (UI brand, document title, compose project, package name, README);
  5. starts a fresh protocol instance with `tools/ai-init --derive` (task history reset,
     knowledge and decisions inherited, provenance recorded);
  6. git init + initial commit.
Everything else (code, tests, docs, ADRs, deployment tiers) is inherited unchanged; optional
modules are switched by configuration, so `./dev check` stays meaningful in the new project.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

BLUEPRINT = Path(__file__).resolve().parent.parent
BLUEPRINT_NAME = "ultimate-web-stack-blueprint"
OPTIONAL_MODULES = ["cache", "messaging_nats", "analytics_clickhouse", "observability"]
PROFILES = {
    "core": set(),
    "performance": {"cache"},
    "distributed": {"cache", "messaging_nats", "analytics_clickhouse"},
    "full": {"cache", "messaging_nats", "analytics_clickhouse", "observability"},
}
AUTH_PROFILES = ["basic", "consumer", "b2b", "enterprise"]


def die(msg: str) -> None:
    sys.exit(f"create-project: {msg}")


def slugify(name: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s or "app"


def tracked_files() -> list[str]:
    """Tracked plus untracked-but-not-ignored files of the working tree (never ignored ones:
    secrets in .env, build output, var/)."""
    r = subprocess.run(["git", "-C", str(BLUEPRINT), "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                       capture_output=True, check=True)
    files = sorted({f for f in r.stdout.decode().split("\0") if f})
    return [f for f in files if (BLUEPRINT / f).is_file()]


def blueprint_version() -> str:
    r = subprocess.run(["git", "-C", str(BLUEPRINT), "describe", "--tags", "--always", "--dirty"],
                       capture_output=True, text=True)
    return r.stdout.strip() or "unversioned"


def app_toml(a: argparse.Namespace, modules: set[str]) -> str:
    """Non-secret configuration for the generated project (secrets stay in environment variables)."""
    orgs = a.organizations
    passkey = a.auth != "basic"
    lines = [
        "# Generated by scripts/create-project. Non-secret settings only; secrets come from APP__* env vars.",
        "# Precedence: built-in defaults < this file < environment (APP__SECTION__KEY).",
        "",
        "[auth]",
        f'profile = "{a.auth}"',
        "require_mfa_for_system_admin = true",
        "",
        "[auth.methods]",
        f"passkey = {str(passkey).lower()}",
        "password = true",
        f"enterprise_sso = {str(a.auth == 'enterprise').lower()}",
        "# Social providers: name = \"<IdP id at your identity provider>\", e.g. google = \"...\"",
        "",
        "[tenancy]",
        f"organizations = {str(orgs).lower()}",
        f"allow_org_creation = {str(orgs).lower()}",
        "",
        "[admin]",
        f"enabled = {str(a.admin).lower()}",
        "",
        "[authorization]",
        f'engine = "{"cedar" if a.cedar else "rbac"}"',
        "",
        "[cache]",
        f'backend = "{"redis" if "cache" in modules else "memory"}"',
        *(['# Development Redis from infra/docker/compose.yaml (no credentials). Production: APP__CACHE__REDIS_URL.',
           'redis_url = "redis://127.0.0.1:56379"'] if "cache" in modules else []),
        "",
        "[messaging]",
        f"enabled = {str('messaging_nats' in modules).lower()}",
        "",
        "[analytics]",
        f"enabled = {str('analytics_clickhouse' in modules).lower()}",
        "",
    ]
    return "\n".join(lines)


def profile_name(modules: set[str]) -> str:
    for name in ("full", "distributed", "performance"):
        if PROFILES[name] <= modules:
            return name
    return "core" if not modules else "custom"


def ask(prompt: str, default: str, choices: list[str] | None = None) -> str:
    while True:
        hint = f" [{'/'.join(choices)}]" if choices else ""
        value = input(f"{prompt}{hint} ({default}): ").strip() or default
        if not choices or value in choices:
            return value
        print(f"  choose one of: {', '.join(choices)}")


def interactive(a: argparse.Namespace) -> None:
    """Fill missing answers by asking (only on a terminal; scripts pass flags)."""
    if not sys.stdin.isatty():
        die("--name and DEST are required when not running on a terminal")
    a.name = a.name or ask("Product name", "My App")
    a.dest = a.dest or ask("Directory", f"../{slugify(a.name)}")
    a.auth = ask("Auth profile", a.auth, AUTH_PROFILES)
    a.profile = ask("Architecture profile", a.profile, list(PROFILES))
    a.start = ask("Start the dev stack now?", "no", ["yes", "no"]) == "yes"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dest", nargs="?")
    ap.add_argument("--name")
    ap.add_argument("--profile", choices=list(PROFILES), default="core")
    ap.add_argument("--objective", default=None)
    ap.add_argument("--auth", choices=AUTH_PROFILES, default="b2b")
    ap.add_argument("--organizations", dest="organizations", action="store_true", default=None)
    ap.add_argument("--no-organizations", dest="organizations", action="store_false")
    ap.add_argument("--admin", dest="admin", action="store_true", default=True)
    ap.add_argument("--no-admin", dest="admin", action="store_false")
    ap.add_argument("--cedar", action="store_true")
    ap.add_argument("--modules", default="")
    ap.add_argument("--with-gateway", action="store_true")
    ap.add_argument("--no-git", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--start", dest="start", action="store_true", default=False)
    ap.add_argument("--no-start", dest="start", action="store_false")
    a = ap.parse_args()
    if not a.name or not a.dest:
        interactive(a)

    if a.organizations is None:
        a.organizations = a.auth in ("b2b", "enterprise")
    if a.auth in ("b2b", "enterprise") and not a.organizations:
        die(f"--auth {a.auth} implies organizations; use --auth consumer for single-tenant products")
    modules = set(PROFILES[a.profile]) | {m.strip() for m in a.modules.split(",") if m.strip()}
    unknown = modules - set(OPTIONAL_MODULES)
    if unknown:
        die(f"unknown modules {sorted(unknown)} (known: {', '.join(OPTIONAL_MODULES)})")
    dest = Path(a.dest).expanduser().resolve()
    if dest == BLUEPRINT or BLUEPRINT in dest.parents and not str(dest).startswith(str(BLUEPRINT / "var")):
        die("destination must be outside the blueprint repository (var/ is allowed for tests)")
    if dest.exists() and any(dest.iterdir()) and not a.force:
        die(f"{dest} is not empty (use --force)")
    slug = slugify(a.name)

    dirty = subprocess.run(["git", "-C", str(BLUEPRINT), "status", "--porcelain"], capture_output=True, text=True).stdout.strip()
    if dirty:
        print("create-project: warning: the blueprint has uncommitted changes; they are included", file=sys.stderr)

    # 1. copy
    # Blueprint-only parts: the generator itself, and the runtime experiment (evidence; its result
    # files and ADR stay). A generated product never depends on the blueprint repository.
    skip_prefixes = ["backend/experiments/", "benchmarks/runtime/", "scripts/create-project", "scripts/validate-generated", "scripts/tests/"]
    if not a.with_gateway:
        skip_prefixes.append("backend/gateway/")
    files = [f for f in tracked_files() if not any(f.startswith(p) for p in skip_prefixes)]
    for rel in files:
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(BLUEPRINT / rel, target)
    print(f"create-project: copied {len(files)} files to {dest}")

    # 2. configuration
    (dest / "backend/config").mkdir(parents=True, exist_ok=True)
    (dest / "backend/config/app.toml").write_text(app_toml(a, modules))

    # 3. architecture metadata
    pj = dest / ".ai/config/project.json"
    project = json.loads(pj.read_text())
    arch = project.setdefault("architecture", {})
    arch["profile"] = profile_name(modules)
    comps = arch.setdefault("components", {})
    comps["auth_profile"] = a.auth
    comps["authorization"] = "cedar-default-deny" if a.cedar else "rbac-default-deny"
    comps["tenancy"] = "organizations-shared-schema" if a.organizations else "personal-workspace"
    comps["admin_model"] = "system-trust-level-separate-from-org-roles" if a.admin else "none"
    mods = arch.setdefault("modules", {})
    for name in OPTIONAL_MODULES:
        if name in mods:
            mods[name]["enabled"] = name in modules
            mods[name]["reason"] = ("Selected at generation (create-project --modules)." if name in modules else
                                    "Not selected at generation; enable in backend/config/app.toml and project.json.") + \
                " " + mods[name].get("reason", "")
    if "cache" in mods and "cache" not in modules:
        mods["cache"]["enabled"] = True  # the in-process cache is core; only the Redis adapter is optional
        mods["cache"]["adapter"] = "memory"
    if "cedar" in mods:
        mods["cedar"]["enabled"] = a.cedar
    if "organizations" in mods:
        mods["organizations"]["enabled"] = a.organizations
    if "admin" in mods:
        mods["admin"]["enabled"] = a.admin
    if "gateway_pingora" in mods and not a.with_gateway:
        mods["gateway_pingora"]["paths"] = []
        mods["gateway_pingora"]["reason"] = "Removed at generation (create-project --with-gateway keeps it)."
    if "runtime_monoio" in mods:
        mods["runtime_monoio"]["paths"] = [p for p in mods["runtime_monoio"].get("paths", [])
                                           if not p.startswith(("backend/experiments", "benchmarks/runtime"))]
    arch["knowledge"] = [k for k in arch.get("knowledge", []) if not k.startswith("scripts/create-project")]
    # Validation commands for parts that were removed.
    cmds = project["validation"]["commands"]
    cmds[:] = [c for c in cmds if c["id"] not in ("generator-selftest", "rust-clippy-minimal")]
    # Validation that needs a module's service only applies when the module is selected.
    needs = {"rust-test-cache": "cache", "rust-test-nats": "messaging_nats", "rust-test-clickhouse": "analytics_clickhouse"}
    cmds[:] = [c for c in cmds if needs.get(c["id"]) is None or needs[c["id"]] in modules]
    for c in cmds:
        if c["id"] == "rust-test-cache":  # generated projects run Redis only (Dragonfly is a blueprint comparison)
            c["cmd"] = "TEST_REDIS_URLS=redis://127.0.0.1:56379 cargo test -p app-cache --features redis"
    if not a.with_gateway:
        cmds[:] = [c for c in cmds if c["id"] != "gateway-check"]
        ci = dest / ".github/workflows/ci.yml"
        if ci.exists():
            # Drop the gateway job (from "  gateway:" up to the next top-level job).
            ci.write_text(re.sub(r"\n  gateway:\n(?:    .*\n|\s*\n)*?(?=  [a-z0-9-]+:\n)", "\n", ci.read_text()))
    if a.cedar:
        pass  # rust-test-cedar stays: it is part of every project
    pj.write_text(json.dumps(project, indent=2, ensure_ascii=False) + "\n")

    # Optional modules are cargo features: unselected ones are not compiled into the binaries.
    feats = {"cache": "redis", "messaging_nats": "nats", "analytics_clickhouse": "clickhouse"}
    def set_default_features(rel: str, wanted: list[str]) -> None:
        p = dest / rel
        text = p.read_text()
        new = re.sub(r"^default = \[[^\]]*\]$", "default = [" + ", ".join(f'"{f}"' for f in wanted) + "]", text,
                     count=1, flags=re.MULTILINE)
        if new == text and "default = [" not in text:
            die(f"{rel}: no default feature list to rewrite")
        p.write_text(new)
    selected = [feats[m] for m in ("cache", "messaging_nats", "analytics_clickhouse") if m in modules]
    set_default_features("backend/apps/server/Cargo.toml", selected + (["cedar"] if a.cedar else []))
    set_default_features("backend/apps/worker/Cargo.toml", [f for f in selected if f != "redis"])
    set_default_features("backend/apps/bench/Cargo.toml", [f for f in selected if f != "redis"])

    # 4. names
    def sub(rel: str, old: str, new: str, count: int = 1) -> None:
        p = dest / rel
        if p.exists():
            text = p.read_text()
            if old in text:
                p.write_text(text.replace(old, new, count))

    sub("frontend/src/brand.ts", 'export const BRAND = "App";', f"export const BRAND = {json.dumps(a.name)};")
    sub("frontend/index.html", "<title>App</title>", f"<title>{a.name}</title>")
    sub("frontend/package.json", '"name": "app-frontend"', f'"name": "{slug}-frontend"')
    sub("infra/docker/compose.yaml", "name: ${COMPOSE_PROJECT_NAME:-uwsb}", f"name: ${{COMPOSE_PROJECT_NAME:-{slug}}}")
    if not a.with_gateway:
        sub("backend/Cargo.toml", 'exclude = ["gateway", "experiments/runtime"]', "exclude = []")
    else:
        sub("backend/Cargo.toml", 'exclude = ["gateway", "experiments/runtime"]', 'exclude = ["gateway"]')
    created = dt.date.today().isoformat()
    readme = [
        f"# {a.name}",
        "",
        f"Generated on {created} from **{BLUEPRINT_NAME}** ({blueprint_version()}) with:",
        "",
        "```",
        "scripts/create-project " + " ".join(sys.argv[1:]),
        "```",
        "",
        "| setting | value |",
        "|---|---|",
        f"| auth profile | `{a.auth}` |",
        f"| organizations | {'yes' if a.organizations else 'no (personal workspace)'} |",
        f"| system admin console | {'yes' if a.admin else 'no'} |",
        f"| authorization engine | {'Cedar' if a.cedar else 'RBAC'} |",
        f"| optional modules | {', '.join(sorted(modules)) or 'none (core profile)'} |",
        "",
        "## Start",
        "",
        "```sh",
        "./dev setup       # toolchains, dependencies, git hooks",
        "./dev up          # PostgreSQL (+ selected modules), API, worker, SPA with a mock identity provider",
        "./dev check       # every canonical validation command (tools/ai-validate)",
        "```",
        "",
        "Configuration: `backend/config/app.toml` (non-secret), `APP__*` environment variables (see `.env.example`).",
        "Architecture, decisions and constraints inherited from the blueprint: `.ai/knowledge/`, `docs/`.",
        "AI agents: read `AI_PROTOCOL.md` first.",
        "",
    ]
    (dest / "README.md").write_text("\n".join(readme))

    # 5. fresh protocol instance (template's own mechanism)
    init = [sys.executable, "tools/ai-init", "--derive", "--name", a.name, "--origin-name", BLUEPRINT_NAME,
            "--origin-version", blueprint_version(), "--no-check"]
    if a.objective:
        init += ["--objective", a.objective]
    subprocess.run(init, cwd=dest, check=True, stdout=subprocess.DEVNULL)

    # 6. git
    if not a.no_git:
        subprocess.run(["git", "init", "-q", "-b", "main"], cwd=dest, check=True)
        subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=dest, check=True)
        subprocess.run(["git", "add", "-A"], cwd=dest, check=True)
        subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "commit", "-q", "-m",
                        f"Generate {a.name} from {BLUEPRINT_NAME} ({blueprint_version()})"], cwd=dest, check=True)
    subprocess.run([sys.executable, "tools/ai-map", "--quiet"], cwd=dest, check=True)  # after the commit (map is gitignored)
    check = subprocess.run([sys.executable, "tools/ai-check"], cwd=dest, capture_output=True, text=True)
    print(check.stdout.strip().splitlines()[-1] if check.stdout else check.stderr)
    print(f"create-project: done. Next: cd {dest} && ./dev setup && ./dev up")
    if a.start and check.returncode == 0:
        return subprocess.run(["./dev", "up"], cwd=dest).returncode
    return check.returncode


if __name__ == "__main__":
    sys.exit(main())
