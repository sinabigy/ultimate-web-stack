#!/usr/bin/env python3
"""validate-generated: prove a generated project works on its own (blueprint-only tool).

    scripts/validate-generated PATH [--report FILE]

Runs inside the generated project only (it never reads the blueprint):
   1. git history present, ai-check, ai-map               (protocol)
   2. ./dev setup                                         (toolchains, dependencies, hooks)
   3. ./dev up --no-app                                   (services of the selected modules only)
   4. ./dev check                                         (every canonical validation command,
                                                           incl. tests, frontend/backend builds,
                                                           E2E, infra verification, release image)
   5. ./dev up + ./dev test --system                      (frontend/API/DB/auth/jobs/modules live)
   6. absence of unselected modules: no service container, no client library in the server
      binary, no enabled configuration
Writes a JSON report (default: <project>/var/validation-report.json). Exit 1 on any failure.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

# module → (compose service, pattern that proves its client library is compiled in). Rust symbols
# are mangled, so `redis::` never appears in a binary; the crate's registry source path (panic
# locations, debug info) does, e.g. `.../redis-0.32.7/src/...`.
MODULES = {
    "cache": ("redis", rb"/redis-\d+\.\d+\.\d+/"),
    "messaging_nats": ("nats", rb"/async-nats-\d+\.\d+\.\d+/"),
    "analytics_clickhouse": ("clickhouse", rb"/clickhouse-\d+\.\d+\.\d+/"),
}
steps: list[dict] = []


def step(name: str, ok: bool, detail: str = "", seconds: float | None = None) -> bool:
    steps.append({"step": name, "ok": ok, "detail": detail, "seconds": seconds})
    print(f"[{'PASS' if ok else 'FAIL'}] {name}{f' ({seconds:.0f}s)' if seconds else ''} {detail}", flush=True)
    return ok


def run(cmd: list[str] | str, cwd: Path, timeout: int = 3600, env: dict | None = None) -> tuple[int, str, float]:
    t = time.time()
    r = subprocess.run(cmd, cwd=cwd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout,
                       env={**os.environ, **(env or {})})
    return r.returncode, (r.stdout + r.stderr), time.time() - t


def wait_http(url: str, seconds: int) -> bool:
    end = time.time() + seconds
    while time.time() < end:
        try:
            with urllib.request.urlopen(url, timeout=2):
                return True
        except Exception:  # noqa: BLE001
            time.sleep(2)
    return False


def runtime_configuration(root: Path, modules: set[str]) -> bool:
    """The running server logs what it runs with; it must match the selection (e.g. Cedar is not
    only compiled in but the active engine)."""
    log = root / "var/log/app-server.log"
    text = re.sub(r"\x1b\[[0-9;]*m", "", log.read_text(errors="replace")) if log.exists() else ""
    # Pretty format: "... INFO app_server: configuration authorization=Cedar ..."; JSON format:
    # {"message":"configuration","authorization":"Cedar",...}.
    line = next((ln for ln in text.splitlines()
                 if "app_server: configuration " in ln or '"message":"configuration"' in ln), "")
    if line.lstrip().startswith("{"):
        line = " ".join(f"{k}={v}" for k, v in json.loads(line).items())
    fields = dict(re.findall(r"(\w+)=(\S+)", line))
    expect = {
        "authorization": "Cedar" if "cedar" in modules else "Rbac",
        "organizations": str("organizations" in modules).lower(),
        "admin": str("admin" in modules).lower(),
        "cache": "Redis" if "cache" in modules else "Memory",
        "messaging_nats": str("messaging_nats" in modules).lower(),
        "analytics_clickhouse": str("analytics_clickhouse" in modules).lower(),
    }
    wrong = {k: (fields.get(k), v) for k, v in expect.items() if fields.get(k) != v}
    return step("running server configuration matches the selection", bool(line) and not wrong,
         " ".join(f"{k}={v}" for k, v in expect.items()) + (f" MISMATCH {wrong}" if wrong else ""))


def stop(app: subprocess.Popen) -> None:
    """Stop `./dev up` and its children. EPERM/ESRCH mean the group already exited (macOS reports a
    group of zombies as EPERM)."""
    for sig, wait in ((signal.SIGINT, 30), (signal.SIGKILL, 5)):
        try:
            os.killpg(app.pid, sig)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            app.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("path")
    ap.add_argument("--report")
    a = ap.parse_args()
    root = Path(a.path).expanduser().resolve()
    env = {"PATH": f"{Path.home()}/.cargo/bin:/opt/homebrew/bin:{os.environ.get('PATH', '')}"}
    project = json.loads((root / ".ai/config/project.json").read_text())
    mods = project["architecture"]["modules"]
    modules = {m for m, v in mods.items() if v.get("enabled")}
    # The in-process cache is core; the `cache` module counts as selected only with a Redis adapter.
    if mods.get("cache", {}).get("adapter", "memory") == "memory":
        modules.discard("cache")
    compose_name = re.search(r"COMPOSE_PROJECT_NAME:-([^}]+)\}", (root / "infra/docker/compose.yaml").read_text()).group(1)
    print(f"validating {root} (compose project {compose_name}; modules: {sorted(modules)})")

    try:
        return validate(root, env, modules, compose_name, a.report)
    finally:
        run(["./dev", "down"], root, env=env)


def validate(root: Path, env: dict, modules: set[str], compose_name: str, report_path: str | None) -> int:
    code, out, _ = run(["git", "log", "--oneline"], root)
    step("git repository initialised", code == 0 and bool(out.strip()), out.strip().splitlines()[0] if out.strip() else "")
    code, out, s = run([sys.executable, "tools/ai-check"], root)
    step("ai-check", code == 0, out.strip().splitlines()[-1] if out.strip() else "", s)
    code, out, s = run([sys.executable, "tools/ai-map"], root)
    step("ai-map", code == 0, "", s)
    code, out, s = run(["./dev", "setup"], root, env=env)
    step("./dev setup", code == 0, "", s)
    code, out, s = run(["./dev", "up", "--no-app"], root, env=env)
    step("./dev up --no-app (services)", code == 0, out.strip().splitlines()[-1][:100] if out.strip() else "", s)
    code, out, s = run(["./dev", "check"], root, env=env, timeout=7200)
    (root / "var").mkdir(exist_ok=True)
    (root / "var" / "check.log").write_text(out)  # full output, for diagnosing a failure
    results = re.findall(r"^\[(PASS|FAIL|SKIP)\]\s+(\S+)", out, re.MULTILINE)
    failed = [n for st, n in results if st != "PASS"]
    summary = re.search(r"ai-validate: .*", out)
    step("./dev check (all canonical validation)", code == 0, (summary.group(0) if summary else "") + (f" failed={failed}" if failed else ""), s)
    steps[-1]["commands"] = [{"id": n, "status": st} for st, n in results]

    # Live application: start it, then run the system smoke journey.
    app = subprocess.Popen(["./dev", "up"], cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           env={**os.environ, **env}, start_new_session=True)
    try:
        up = wait_http("http://localhost:8080/readyz", 600) and wait_http("http://localhost:5190/", 120)
        step("./dev up (API + SPA + mock IdP + simulated provider)", up)
        if up:
            code, out, s = run(["./dev", "test", "--system"], root, env=env, timeout=600)
            smoke = re.search(r"system smoke: .*", out)
            step("./dev test --system", code == 0, smoke.group(0) if smoke else out[-300:], s)
            # system_smoke.py prints f"  {status:4}  {name:44} {detail}"
            steps[-1]["checks"] = [[ln[2:6].strip(), ln[8:52].strip(), ln[52:].strip()] for ln in out.splitlines()
                                   if ln[2:6].strip() in ("PASS", "FAIL", "SKIP") and ln.startswith("  ")]
            code, out, _ = run(["curl", "-s", "http://localhost:5190/"], root)
            step("SPA served by Vite (frontend)", "<div id=" in out or "<!doctype html>" in out.lower())
            runtime_configuration(root, modules)
    finally:
        stop(app)

    # Unselected modules leave nothing behind.
    code, ps, _ = run(["docker", "ps", "--format", "{{.Names}}"], root)
    server = root / "backend/target/debug/app-server"
    blob = server.read_bytes() if server.exists() else b""
    step("server binary present for the compiled-in probes", bool(blob), str(server.relative_to(root)))
    config = (root / "backend/config/app.toml").read_text()
    for module, (service, symbol) in MODULES.items():
        selected = module in modules
        running = f"{compose_name}-{service}-1" in ps
        compiled = re.search(symbol, blob) is not None
        if selected:
            step(f"{module}: selected → service running and compiled in", running and compiled,
                 f"service={running} compiled={compiled}")
        else:
            step(f"{module}: not selected → no service, not compiled", not running and not compiled,
                 f"service={running} compiled={compiled}")
    for section, module in (("messaging", "messaging_nats"), ("analytics", "analytics_clickhouse")):
        enabled = re.search(rf"\[{section}\]\nenabled = (true|false)", config)
        expect = "true" if module in modules else "false"
        step(f"config [{section}] enabled = {expect}", bool(enabled) and enabled.group(1) == expect)

    ok = all(s["ok"] for s in steps)
    report = Path(report_path) if report_path else root / "var" / "validation-report.json"
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps({"project": root.name, "modules": sorted(modules), "ok": ok,
                                  "finished_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "steps": steps}, indent=2) + "\n")
    print(f"validate-generated: {'OK' if ok else 'FAILED'} — report {report}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
