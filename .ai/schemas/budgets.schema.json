{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-project-template.invalid/schemas/budgets.schema.json",
  "title": "Multi-dimensional budgets (canonical)",
  "type": "object",
  "required": [
    "budgets_schema_version",
    "objective",
    "dimensions",
    "classes",
    "stop_and_diagnose"
  ],
  "properties": {
    "budgets_schema_version": {
      "const": 1
    },
    "objective": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "context_tokens": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "tool_calls": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "retries": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "subagents": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "human_interventions": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "validation_runs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "latency_class": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      }
    },
    "stop_and_diagnose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
