{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-project-template.invalid/schemas/capabilities.schema.json",
  "title": "Capability vocabulary and tiers (canonical, vendor-free)",
  "type": "object",
  "required": [
    "capabilities_schema_version",
    "core_capabilities",
    "tiers",
    "classes"
  ],
  "properties": {
    "capabilities_schema_version": {
      "const": 1
    },
    "core_capabilities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^core\\.[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_namespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "typical_work": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_model": {
            "type": "boolean"
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "description": "Ordered vocabularies (lowest first). Extend by appending; never rename.",
      "required": [
        "reasoning",
        "cost",
        "latency",
        "context"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uniqueItems": true
      }
    }
  }
}
